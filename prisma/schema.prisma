  cart_items cart_items[]
  users      users        @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_carts_users")
}

model categories {
  category_id   Int        @id(map: "pk_categories") @default(autoincrement())
