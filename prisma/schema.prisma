  old_value   String?
  new_value   String?
  ip_address  String?  @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  users       users?   @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_logs_users")
}

model banners {
  banner_id             Int     @id(map: "pk_banners") @default(autoincrement())
