DATABASE_URL=postgresql://webapple_demo:webapple-demo-db-password@localhost:5432/webapple_demo
APP_NAME=WebApple
CUSTOMER_API_PORT=5001
ADMIN_API_PORT=5002
CLIENT_URL=http://localhost:3000
ADMIN_CLIENT_URL=http://localhost:3000
JWT_SECRET=webapple-demo-jwt-secret-change-before-non-demo-use
JWT_EXPIRES_IN=24h
DEMO_ACCOUNT_PASSWORD=WebAppleDemo2026!

# Optional at startup; required only when Customer forgot-password sends mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX=20

# Optional. CLOUDINARY_URL has priority over the three separate values.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. All three credentials are required to enable payOS.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/payos/return
PAYOS_CANCEL_URL=http://localhost:3000/payment/payos/cancel
PAYOS_WEBHOOK_URL=
